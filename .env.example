# Development-only defaults. Copy to .env only when you need local overrides.
POSTGRES_DB=resolveflow
POSTGRES_USER=resolveflow
POSTGRES_PASSWORD=change-me-for-nonlocal-use
DATABASE_URL=postgresql+asyncpg://resolveflow:change-me-for-nonlocal-use@db:5432/resolveflow
APP_ENV=development
API_PORT=8000
WEB_PORT=5173

# Checkpoint 3 voice lab (optional). Keep real values only in ignored .env.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
